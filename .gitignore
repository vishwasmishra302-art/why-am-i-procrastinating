# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Jupyter ────────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Trained models (large binary files) ───────────────────────────────────────
# Committed so Streamlit Cloud can load them without re-training.
# models/*.pkl   ← intentionally NOT ignored

# ── Data (raw data may be sensitive or large) ─────────────────────────────────
# demo_dataset.csv is synthetic — safe to commit for cloud deployment.
# data/raw/*.csv   ← intentionally NOT ignored
data/processed/*.csv

# ── Streamlit cache ────────────────────────────────────────────────────────────
# .streamlit/config.toml must be committed — it sets the light theme.
# Only ignore the secrets file if present.
.streamlit/secrets.toml

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store

# ── IDE ────────────────────────────────────────────────────────────────────────
.vscode/
.idea/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
*.egg-info/
dist/
build/

# ── Generated report figures (large PNGs) ─────────────────────────────────────
# The figures/ directory is generated by src/eda.py and src/evaluate.py.
# Commit only the Markdown summary; regenerate figures on demand.
reports/figures/*.png
data/processed/figures/*.png
